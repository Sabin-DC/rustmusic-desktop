<!-- Case à cocher : plusieurs bibliothèques peuvent être actives ensemble. -->
<button class="shrink-0 pl-2.5 py-2 cursor-pointer" role="checkbox" aria-checked={b.active} onclick={Msg::ToggleLibrary(b.id)}>
    {#if b.active}
        <div class="relative w-7 h-7 rounded-md flex items-center justify-center bg-green-500/20 text-green-500">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round"><path d="m4.5 12.75 6 6 9-13.5"/></svg>
        </div>
    {:else}
        <div class="relative w-7 h-7 rounded-md flex items-center justify-center bg-neutral-100 dark:bg-neutral-800 text-neutral-400 dark:text-neutral-500">
            <Icon icon="material-symbols:hard-drive-outline" width={14} />
        </div>
    {/if}
</button>
<!-- Le reste de la ligne n'active que celle-ci. -->
<button class="flex-1 min-w-0 flex items-center gap-2.5 px-2.5 py-2 cursor-pointer" onclick={Msg::ChooseLibrary(b.id)}>
    {@include "LibraryInfos.ui"}
</button>
{@include "LibraryManage.ui"}
